<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <div class="main w-full min-h-screen bg-zinc-900">
      <div class="form p-10 text-white">
        <form action="">
          <input
            class="block mt-2 w-full rounded-md outline-none px-5 py-2 bg-zinc-800"
            type="text"
            placeholder="Title goes here"
          />
          <textarea
            class="block w-full rounded-md px-5 outline-none py-2 bg-zinc-800 mt-2 resize-none"
            placeholder="Write your task detail here"
          ></textarea>
          <input
            class="mt-2 bg-blue-600 px-5 py-2 rounded-md"
            type="submit"
            value="Create Tasks"
          />
        </form>
      </div>
      <div class="tasks flex gap-3 flex-wrap p-10">
        <div class="task hidden w-72 px-3 py-4 rounded-md bg-zinc-800">
          <h1 class="text-white test-3xl tracking-tighter">
            Some task goes here
          </h1>
          <a href="" class="text-blue-500 inline-block mt-3">Read More</a>
        </div>
        <div class="task w-72 hidden px-3 py-4 rounded-md bg-zinc-800">
          <h1 class="text-white test-3xl tracking-tighter">
            Some task goes here
          </h1>
          <a href="" class="text-blue-500 inline-block mt-3">Read More</a>
        </div>
        <div class="task w-72 hidden px-3 py-4 rounded-md bg-zinc-800">
          <h1 class="text-white test-3xl tracking-tighter">
            Some task goes here
          </h1>
          <a href="" class="text-blue-500 inline-block mt-3">Read More</a>
        </div>
        <h3 class="text-zinc-500">No tasks yet.</h3>
      </div>
    </div>
  </body>
</html>
