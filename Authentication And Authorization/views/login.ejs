<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
  </head>
  <body>
    <div class="w-full text-white h-screen p-10 bg-zinc-900">
      <h3 class="text 3-xl mb-3">Create User</h3>
      <form method="post" action="/login">
        <input
          type="email"
          class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-800 outline-none"
          placeholder="email"
          name="email"
        />
        <input
          class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-800 outline-none"
          type="password"
          placeholder="password"
          name="password"
        />

        <input
          class="px-5 py-2 rounded-md bg-blue-500"
          type="submit"
          value="Login your Account"
        />
      </form>
    </div>
  </body>
</html>
